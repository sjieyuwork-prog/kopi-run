{
  "name": "kopi-run",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "wrangler d1 migrations apply kopi-run --local",
    "dev": "npm run migrate && wrangler dev --ip 127.0.0.1",
    "dev:lan": "npm run migrate && wrangler dev --ip 0.0.0.0 --local-protocol https",
    "migrate:remote": "wrangler d1 migrations apply kopi-run --remote",
    "deploy": "npm run migrate:remote && wrangler deploy",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.159.0"
  }
}
